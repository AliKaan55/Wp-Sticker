# Optional: path to your own FFmpeg binary. If empty, the bundled ffmpeg-static binary is used.
FFMPEG_PATH=

# Optional: disable Next.js anonymous telemetry.
NEXT_TELEMETRY_DISABLED=1

# Required for importing Giphy/Tenor *page* links (giphy.com/gifs/...,
# tenor.com/view/...). Not needed for direct media.giphy.com / media.tenor.com
# links, or for any other supported media/X link.
#
# Giphy: https://developers.giphy.com/dashboard/ -> "Create an App" -> API Key
# Tenor:  https://developers.google.com/tenor/guides/quickstart -> API Key
GIPHY_API_KEY= "wwFgBlTMxOoB8NHvjejW4TqjnVCsG5DP"
TENOR_API_KEY=
